# .env.local.example — committed template. Copy to .env.local (gitignored).
#   cp .env.local.example .env.local
# RULE: item NAMES and non-secret config only. Secret values are resolved at
# runtime from Bitwarden by ~/.claude/scripts/bw-env.sh (bw_load_env), never stored.

# Non-secret config (exported verbatim)
VERCEL_PROJECT=opencode-learning

# Secret: Bitwarden item name (field defaults to password). Confirm the exact
# name once the vault is unlocked:
#   bw list items --search vercel --session "$BW_SESSION" | jq -r '.[].name'
VERCEL_TOKEN=bw:vercel-token
